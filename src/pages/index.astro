---
import { Image } from "astro:assets";
import HeroImage from "@/assets/images/home-open-source-ilustration.svg";
import Layout from "@/layouts/Layout.astro";
import ProjectList from "@/components/ProjectList.astro";
import { projects } from "@/data/projects";
const principles = [
  [
    "01",
    "Share what we know.",
    "We make our work open so people can explore it, learn from it, and build on it.",
  ],
  [
    "02",
    "Keep it focused.",
    "We know what we want each project to do, and keep it focused on doing that well.",
  ],
  [
    "03",
    "Make it your own.",
    "Got an idea of your own? Have a look at the code and see what the license lets you build on.",
  ],
];
---

<Layout
  title="Papua Open Source"
  description="Independent projects rooted in Papua. Explore the work, the stories behind it, and the ideas you can learn from."
>
  <section class="section home-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Rooted in Papua. Shared with you.</p>
        <h1>
          Made with Love.
          <br />
          For Papua.
        </h1>
        <p class="lead">
          We’re making places to learn a word, find a recipe, and read stories
          from Papua. They’re things we enjoy using ourselves, and we hope you
          will too. Have a look around, and if you’re curious about how they
          work, you can explore the code as well.
        </p>
        <div class="actions">
          <a class="action" href="/projects/">
            Explore our projects <span aria-hidden="true">↗</span>
          </a>
          <a class="action secondary" href="/open-source/"> Our approach </a>
        </div>
      </div>
      <Image
        src={HeroImage}
        alt="People collaborating on an open source project"
        width={520}
        height={380}
        class="hero-image"
      />
    </div>
  </section>
  <section class="section surface">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">How we work</p>
        <h2>
          Make something useful.
          <br />
          Share what we learn.
        </h2>
      </div>
      <div class="three-columns">
        {
          principles.map(([number, title, text]) => (
            <div class="principle">
              <span class="eyebrow">{number}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Selected projects</p>
        <h2>Here’s what we’re making.</h2>
        <p>
          Food, language, and the stories of a place. Get to know the ideas
          behind three of our projects.
        </p>
      </div>
      <ProjectList projects={projects.filter((project) => project.featured)} />
      <a class="action secondary" href="/projects/">
        Explore all projects <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="section surface">
    <div class="container narrow">
      <p class="eyebrow">Yours to explore</p>
      <h2>Take a look around.</h2>
      <p class="lead">
        Try a recipe. Learn a word. Find a story you want to share. If something
        catches your interest, follow it—you might end up making something of
        your own.
      </p>
      <div class="actions">
        <a class="action" href="/contribute/"> Support the work </a>
        <a class="action secondary" href="https://discord.gg/kuW9EajFrw">
          Join us on Discord ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
